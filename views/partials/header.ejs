       <!-- ========================================
         JAVASCRIPT DO WIDGET
         Copie este script para seu site
         ======================================== -->
      <script>
        (function() {
            'use strict';

            const A11Y = {
                toggle: document.getElementById('a11yToggle'),
                panel: document.getElementById('a11yPanel'),
                close: document.getElementById('a11yClose'),
                increaseFont: document.getElementById('a11yIncreaseFont'),
                decreaseFont: document.getElementById('a11yDecreaseFont'),
                highContrast: document.getElementById('a11yHighContrast'),
                dyslexia: document.getElementById('a11yDyslexia'),
                grayscale: document.getElementById('a11yGrayscale'),
                underlineLinks: document.getElementById('a11yUnderlineLinks'),
                readingGuide: document.getElementById('a11yReadingGuide'),
                readingLine: document.getElementById('a11yReadingLine'),
                reset: document.getElementById('a11yReset'),
                body: document.body,
                fontLevel: 0
            };

            // Carregar configurações salvas
            function loadSettings() {
                const settings = JSON.parse(localStorage.getItem('a11ySettings') || '{}');
                
                A11Y.fontLevel = settings.fontLevel || 0;
                updateFontSize();

                if (settings.highContrast) toggleHighContrast(true);
                if (settings.dyslexia) toggleDyslexia(true);
                if (settings.grayscale) toggleGrayscale(true);
                if (settings.underlineLinks) toggleUnderlineLinks(true);
                if (settings.readingGuide) toggleReadingGuide(true);

                updateToggleIndicator();
            }

            // Salvar configurações
            function saveSettings() {
                const settings = {
                    fontLevel: A11Y.fontLevel,
                    highContrast: A11Y.body.classList.contains('a11y-high-contrast'),
                    dyslexia: A11Y.body.classList.contains('a11y-dyslexia'),
                    grayscale: A11Y.body.classList.contains('a11y-grayscale'),
                    underlineLinks: A11Y.body.classList.contains('a11y-underline-links'),
                    readingGuide: A11Y.body.classList.contains('a11y-reading-guide')
                };
                localStorage.setItem('a11ySettings', JSON.stringify(settings));
                updateToggleIndicator();
            }

            // Atualizar indicador visual do toggle
            function updateToggleIndicator() {
                const hasSettings = A11Y.fontLevel !== 0 || 
                    A11Y.body.classList.contains('a11y-high-contrast') ||
                    A11Y.body.classList.contains('a11y-dyslexia') ||
                    A11Y.body.classList.contains('a11y-grayscale') ||
                    A11Y.body.classList.contains('a11y-underline-links') ||
                    A11Y.body.classList.contains('a11y-reading-guide');
                
                A11Y.toggle.classList.toggle('has-settings', hasSettings);
            }

            // Toggle do painel
            function togglePanel() {
                const isActive = A11Y.panel.classList.toggle('active');
                A11Y.toggle.setAttribute('aria-expanded', isActive);
            }

            // Aumentar fonte
            function increaseFont() {
                if (A11Y.fontLevel < 2) {
                    A11Y.fontLevel++;
                    updateFontSize();
                    saveSettings();
                }
            }

            // Diminuir fonte
            function decreaseFont() {
                if (A11Y.fontLevel > 0) {
                    A11Y.fontLevel--;
                    updateFontSize();
                    saveSettings();
                }
            }

            // Atualizar tamanho da fonte
            function updateFontSize() {
                A11Y.body.classList.remove('a11y-large-text', 'a11y-larger-text');
                
                if (A11Y.fontLevel === 1) {
                    A11Y.body.classList.add('a11y-large-text');
                } else if (A11Y.fontLevel === 2) {
                    A11Y.body.classList.add('a11y-larger-text');
                }

                updateButtonState(A11Y.increaseFont, A11Y.fontLevel > 0);
                updateButtonState(A11Y.decreaseFont, A11Y.fontLevel > 0);
            }

            // Toggle alto contraste
            function toggleHighContrast(skipSave) {
                A11Y.body.classList.toggle('a11y-high-contrast');
                updateButtonState(A11Y.highContrast);
                if (!skipSave) saveSettings();
            }

            // Toggle fonte dislexia
            function toggleDyslexia(skipSave) {
                A11Y.body.classList.toggle('a11y-dyslexia');
                updateButtonState(A11Y.dyslexia);
                if (!skipSave) saveSettings();
            }

            // Toggle escala de cinza
            function toggleGrayscale(skipSave) {
                A11Y.body.classList.toggle('a11y-grayscale');
                updateButtonState(A11Y.grayscale);
                if (!skipSave) saveSettings();
            }

            // Toggle sublinhar links
            function toggleUnderlineLinks(skipSave) {
                A11Y.body.classList.toggle('a11y-underline-links');
                updateButtonState(A11Y.underlineLinks);
                if (!skipSave) saveSettings();
            }

            // Toggle guia de leitura
            function toggleReadingGuide(skipSave) {
                A11Y.body.classList.toggle('a11y-reading-guide');
                updateButtonState(A11Y.readingGuide);
                if (!skipSave) saveSettings();
            }

            // Atualizar movimento da linha de leitura
            function updateReadingLine(e) {
                if (A11Y.body.classList.contains('a11y-reading-guide')) {
                    A11Y.readingLine.style.top = e.clientY + 'px';
                }
            }

            // Atualizar estado visual do botão
            function updateButtonState(button, forceActive) {
                const isActive = forceActive !== undefined ? forceActive : A11Y.body.classList.contains(button.dataset.class);
                button.classList.toggle('active', isActive);
                button.setAttribute('aria-pressed', isActive);
            }

            // Resetar tudo
            function resetAll() {
                A11Y.fontLevel = 0;
                A11Y.body.classList.remove(
                    'a11y-large-text',
                    'a11y-larger-text',
                    'a11y-high-contrast',
                    'a11y-dyslexia',
                    'a11y-grayscale',
                    'a11y-underline-links',
                    'a11y-reading-guide'
                );

                document.querySelectorAll('.a11y-option').forEach(btn => {
                    btn.classList.remove('active');
                    btn.setAttribute('aria-pressed', 'false');
                });

                localStorage.removeItem('a11ySettings');
                updateToggleIndicator();
            }

            // Event Listeners
            A11Y.toggle.addEventListener('click', togglePanel);
            A11Y.close.addEventListener('click', togglePanel);
            A11Y.increaseFont.addEventListener('click', increaseFont);
            A11Y.decreaseFont.addEventListener('click', decreaseFont);
            A11Y.highContrast.addEventListener('click', () => toggleHighContrast());
            A11Y.dyslexia.addEventListener('click', () => toggleDyslexia());
            A11Y.grayscale.addEventListener('click', () => toggleGrayscale());
            A11Y.underlineLinks.addEventListener('click', () => toggleUnderlineLinks());
            A11Y.readingGuide.addEventListener('click', () => toggleReadingGuide());
            A11Y.reset.addEventListener('click', resetAll);

            // Movimento da linha de leitura
            document.addEventListener('mousemove', updateReadingLine);

            // Fechar ao clicar fora
            document.addEventListener('click', (e) => {
                if (!e.target.closest('.a11y-widget') && A11Y.panel.classList.contains('active')) {
                    togglePanel();
                }
            });

            // Atalhos de teclado
            document.addEventListener('keydown', (e) => {
                // Alt + A: Abrir/Fechar painel
                if (e.altKey && e.key.toLowerCase() === 'a') {
                    e.preventDefault();
                    togglePanel();
                }
                
                // Alt + 1: Aumentar texto
                if (e.altKey && e.key === '1') {
                    e.preventDefault();
                    increaseFont();
                }
                
                // Alt + 2: Diminuir texto
                if (e.altKey && e.key === '2') {
                    e.preventDefault();
                    decreaseFont();
                }
                
                // Alt + C: Alto contraste
                if (e.altKey && e.key.toLowerCase() === 'c') {
                    e.preventDefault();
                    toggleHighContrast();
                }
                
                // Alt + D: Fonte dislexia
                if (e.altKey && e.key.toLowerCase() === 'd') {
                    e.preventDefault();
                    toggleDyslexia();
                }
                
                // Alt + G: Escala de cinza
                if (e.altKey && e.key.toLowerCase() === 'g') {
                    e.preventDefault();
                    toggleGrayscale();
                }
                
                // Alt + L: Sublinhar links
                if (e.altKey && e.key.toLowerCase() === 'l') {
                    e.preventDefault();
                    toggleUnderlineLinks();
                }
                
                // Alt + R: Guia de leitura
                if (e.altKey && e.key.toLowerCase() === 'r') {
                    e.preventDefault();
                    toggleReadingGuide();
                }
                
                // Alt + 0: Resetar tudo
                if (e.altKey && e.key === '0') {
                    e.preventDefault();
                    resetAll();
                }
                
                // ESC: Fechar painel se estiver aberto
                if (e.key === 'Escape' && A11Y.panel.classList.contains('active')) {
                    togglePanel();
                }
            });

            // Inicializar
            loadSettings();
        })();
    </script>

  <main>