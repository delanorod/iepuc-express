 <style>
        /* ========================================
           SISTEMA DE ACESSIBILIDADE MODULAR
           
           ======================================== */
        
        :root {
            --acc-primary: #2c3e50;
            --acc-secondary: #3498db;
            --acc-accent: #e74c3c;
            --acc-success: #27ae60;
            --acc-bg: #ffffff;
            --acc-text: #333333;
            --acc-border: #e0e0e0;
            --acc-shadow: rgba(0, 0, 0, 0.15);
            --acc-transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .a11y-widget {
            position: fixed;
            top: 50%;
            right: 0;
            transform: translateY(-50%);
            z-index: 999999;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            font-size: 14px;
        }

        .a11y-toggle {
            background: var(--acc-primary);
            color: white;
            border: none;
            border-radius: 12px 0 0 12px;
            width: 56px;
            height: 56px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: -3px 0 12px var(--acc-shadow);
            transition: var(--acc-transition);
            font-size: 24px;
            position: relative;
        }

        .a11y-toggle:hover {
            background: var(--acc-secondary);
            width: 64px;
            box-shadow: -5px 0 20px var(--acc-shadow);
        }

        .a11y-toggle:focus {
            outline: 3px solid var(--acc-secondary);
            outline-offset: 2px;
        }

        .a11y-toggle::after {
            content: '';
            position: absolute;
            top: 8px;
            right: 8px;
            width: 8px;
            height: 8px;
            background: var(--acc-success);
            border-radius: 50%;
            opacity: 0;
            transition: var(--acc-transition);
        }

        .a11y-toggle.has-settings::after {
            opacity: 1;
        }

        .a11y-panel {
            background: var(--acc-bg);
            border-radius: 12px 0 0 12px;
            box-shadow: -5px 0 25px var(--acc-shadow);
            padding: 24px;
            width: 0;
            max-height: 80vh;
            overflow: hidden;
            opacity: 0;
            transition: var(--acc-transition);
            position: absolute;
            right: 56px;
            top: 50%;
            transform: translateY(-50%);
        }

        .a11y-panel.active {
            width: 320px;
            opacity: 1;
            overflow-y: auto;
        }

        .a11y-panel::-webkit-scrollbar {
            width: 6px;
        }

        .a11y-panel::-webkit-scrollbar-track {
            background: transparent;
        }

        .a11y-panel::-webkit-scrollbar-thumb {
            background: var(--acc-border);
            border-radius: 3px;
        }

        .a11y-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
            padding-bottom: 16px;
            border-bottom: 2px solid var(--acc-border);
        }

        .a11y-header h3 {
            margin: 0;
            color: var(--acc-primary);
            font-size: 18px;
            font-weight: 600;
        }

        .a11y-close {
            background: transparent;
            border: none;
            color: var(--acc-text);
            cursor: pointer;
            font-size: 20px;
            padding: 4px;
            opacity: 0.6;
            transition: var(--acc-transition);
        }

        .a11y-close:hover {
            opacity: 1;
            color: var(--acc-accent);
        }

        .a11y-section {
            margin-bottom: 20px;
        }

        .a11y-section-title {
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            color: var(--acc-text);
            opacity: 0.7;
            margin-bottom: 12px;
            letter-spacing: 0.5px;
        }

        .a11y-options {
            display: grid;
            gap: 8px;
        }

        .a11y-option {
            background: #f8f9fa;
            border: 2px solid transparent;
            border-radius: 10px;
            padding: 14px 16px;
            cursor: pointer;
            transition: var(--acc-transition);
            display: flex;
            align-items: center;
            gap: 12px;
            text-align: left;
            width: 100%;
            position: relative;
            overflow: hidden;
        }

        .a11y-option::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            height: 100%;
            width: 3px;
            background: var(--acc-secondary);
            transform: scaleY(0);
            transition: var(--acc-transition);
        }

        .a11y-option:hover {
            background: #e9ecef;
            transform: translateX(-4px);
        }

        .a11y-option:hover::before {
            transform: scaleY(1);
        }

        .a11y-option.active {
            background: var(--acc-secondary);
            color: white;
            border-color: var(--acc-secondary);
        }

        .a11y-option.active::before {
            background: white;
            transform: scaleY(1);
        }

        .a11y-option i {
            font-size: 18px;
            width: 24px;
            text-align: center;
            flex-shrink: 0;
        }

        .a11y-option-text {
            flex: 1;
        }

        .a11y-option-label {
            display: block;
            font-weight: 500;
            font-size: 14px;
        }

        .a11y-option-desc {
            display: block;
            font-size: 11px;
            opacity: 0.8;
            margin-top: 2px;
        }

        .a11y-option.active .a11y-option-desc {
            opacity: 0.9;
        }

        .a11y-reset {
            background: var(--acc-accent);
            color: white;
            width: 100%;
            margin-top: 12px;
        }

        .a11y-reset:hover {
            background: #c0392b;
        }

        .a11y-reset:hover::before {
            background: white;
        }

        /* Estados de acessibilidade aplicados ao body */
        body.a11y-high-contrast {
            background-color: #000 !important;
            color: #fff !important;
        }

        body.a11y-high-contrast *:not(.a11y-widget *):not(.a11y-widget) {
            background-color: #000 !important;
            color: #fff !important;
            border-color: #fff !important;
        }

        body.a11y-high-contrast a {
            color: #4da6ff !important;
            text-decoration: underline !important;
        }

        body.a11y-dyslexia {
            font-family: 'Comic Sans MS', 'Arial Rounded MT Bold', 'Lexend', sans-serif !important;
            letter-spacing: 0.12em !important;
            word-spacing: 0.16em !important;
            line-height: 1.8 !important;
        }

        body.a11y-large-text {
            font-size: 118% !important;
        }

        body.a11y-larger-text {
            font-size: 136% !important;
        }

        body.a11y-grayscale *:not(.a11y-widget):not(.a11y-widget *) {
            filter: grayscale(100%);
        }
        
        /* Garantir que o widget permaneça fixo */
        .a11y-widget {
            filter: none !important;
        }

        body.a11y-underline-links a {
            text-decoration: underline !important;
        }

        body.a11y-reading-guide {
            cursor: crosshair;
        }

        .a11y-reading-line {
            position: fixed;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--acc-accent);
            pointer-events: none;
            z-index: 999998;
            box-shadow: 0 0 10px rgba(231, 76, 60, 0.5);
            display: none;
        }

        body.a11y-reading-guide .a11y-reading-line {
            display: block;
        }

        /* Responsividade */
        @media (max-width: 768px) {
            .a11y-panel.active {
                width: 280px;
            }
            
            .a11y-toggle {
                width: 50px;
                height: 50px;
                font-size: 20px;
            }
        }

        @media (max-width: 480px) {
            .a11y-widget {
                top: auto;
                bottom: 20px;
                right: 20px;
                transform: none;
            }

            .a11y-toggle {
                border-radius: 50%;
            }
            
            .a11y-panel {
                right: 0;
                bottom: 70px;
                top: auto;
                transform: none;
                border-radius: 12px;
                max-height: 60vh;
            }

            .a11y-panel.active {
                width: calc(100vw - 40px);
            }
        }

        /* ========================================
           FIM DO SISTEMA DE ACESSIBILIDADE
           ======================================== */

        /* Exemplo de conteúdo (remover em produção) */
        .demo-content {
            max-width: 800px;
            margin: 0 auto;
            padding: 60px 20px;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        .demo-content h1 {
            color: #2c3e50;
            margin-bottom: 20px;
        }

        .demo-content p {
            line-height: 1.6;
            margin-bottom: 15px;
        }

        .demo-content a {
            color: #3498db;
        }
    </style>

</head>

