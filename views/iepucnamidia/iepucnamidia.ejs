<% const pageTitle = "Página Inicial"; %>
<%- include("../partials/header", { pageTitle: pageTitle }) %>
 <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/js/all.min.js"></script>

<link rel="stylesheet" href="/src/styles.css">


<!-- Blog Content -->
<main class="container mx-auto px-4 py-8">

    <!-- Page Title -->
    <div class="mb-12 text-center">

        <h2 class="text-3xl font-bold text-cyan-600 mb-4 titulo-destaque">
            Matérias na Mídia
        </h2>

        <p class="text-gray-600 max-w-3xl mx-auto">
            Confira as últimas aparições e artigos dos pesquisadores do Instituto de Energia da PUC-Rio na mídia nacional e internacional.
        </p>

    </div>

    <!-- Loading indicator -->
    <div id="loading" class="text-center py-8">

        <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-900">
        </div>

        <p class="mt-2 text-gray-600">
            Carregando matérias...
        </p>

    </div>

    <!-- Error message -->
    <div id="error" class="text-center py-8 hidden">

        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">

            <p>
                Erro ao carregar as matérias.
                Tente novamente mais tarde.
            </p>

        </div>

    </div>

    <!-- Blog Posts Grid -->
    <div
        class="grid grid-cols-1 gap-8 hidden"
        id="blogue">

        <!-- As matérias serão inseridas automaticamente -->

    </div>

    <!-- Load More Button -->
    <div
        class="text-center mt-12 hidden"
        id="loadMoreContainer">

        <button
            id="loadMore"
            class="bg-blue-700 hover:bg-blue-800 text-white font-medium py-3 px-8 rounded-lg transition-colors flex items-center mx-auto">

            <i class="fas fa-plus-circle mr-2"></i>

            Carregar mais matérias

        </button>

    </div>

</main>

<div class="container mx-auto px-4 py-2 flex justify-end">

    <%- include("../partials/voltar") %>

</div>

<br>

<!-- Carregador de matérias via MySQL -->
<script src="/src/mysql_frontend_loader.js"></script>

<%- include("../partials/footer") %>