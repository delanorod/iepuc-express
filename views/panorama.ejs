<script src="/src/google-sheets-loadercards.js"></script>

<!-- Script adicional para garantir o layout de cards -->
<script>
    // Este script modifica a estrutura HTML gerada pelo google-sheets-loader.js
    // para o formato de cards
    
    // Monitora mudanÃ§as no container de matÃ©rias
    const cardsContainer = document.getElementById('cards');
    
    if (cardsContainer) {
        // Observer para detectar quando as matÃ©rias sÃ£o carregadas
        const observer = new MutationObserver((mutations) => {
            mutations.forEach((mutation) => {
                if (mutation.type === 'childList' && mutation.addedNodes.length > 0) {
                    formatarComoCards();
                }
            });
        });
        
        observer.observe(cardsContainer, {
            childList: true,
            subtree: true
        });
    }
    
    function formatarComoCards() {
        const articles = cardsContainer.querySelectorAll('article');
        
        articles.forEach(article => {
            // Se jÃ¡ foi formatado, pula
            if (article.classList.contains('media-card')) {
                return;
            }
            
            // Adiciona classe de card
            article.classList.add('media-card');
            
            // Reorganiza a estrutura interna se necessÃ¡rio
            const img = article.querySelector('img');
            const content = article.querySelector('div');
            
            if (img) {
                img.classList.add('media-card-image');
            }
            
            if (content) {
                content.classList.add('media-card-content');
                
                // Formata elementos internos
                const source = content.querySelector('.text-cyan-600, [class*="fonte"], [class*="source"]');
                if (source) {
                    source.classList.add('media-card-source');
                }
                
                const title = content.querySelector('h3, .titulo, [class*="title"]');
                if (title) {
                    title.classList.add('media-card-title');
                }
                
                const description = content.querySelector('p, .descricao, [class*="description"]');
                if (description) {
                    description.classList.add('media-card-description');
                }
                
                const footer = content.querySelector('.flex, [class*="footer"]');
                if (footer) {
                    footer.classList.add('media-card-footer');
                }
                
                const date = content.querySelector('[class*="date"], time');
                if (date) {
                    date.classList.add('media-card-date');
                }
                
                const link = content.querySelector('a');
                if (link) {
                    link.classList.add('media-card-link');
                }
            }
        });
    }
</script>


