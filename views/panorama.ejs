<link rel="stylesheet" href="/src/styles.css">

<style>
    /* Estilos adicionais para os cards */
    .media-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center; /* Centraliza os itens horizontalmente */
    width: 100%;    
    height: 100%;
    object-fit: cover;
}
    
    .media-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    }
    
.media-card-image {
    width: 100%;
    /* A altura deve ser auto para o aspect-ratio funcionar */
    height: auto; 
    display: block;
    object-fit: cover; /* Garante o preenchimento total */
    object-position: center;
    background-color: #f3f4f6;
}

/* Suas proporções já definidas vão funcionar agora: */
@media (max-width: 768px) { .media-card-image { aspect-ratio: 1; } }
@media (min-width: 769px) and (max-width: 1024px) { .media-card-image { aspect-ratio: 4/3; } }
@media (min-width: 1025px) { .media-card-image { aspect-ratio: 16/9; } }
    
    .media-card-content {
        padding: 1.5rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }
    
    .media-card-source {
        font-size: 0.875rem;
        color: #0891b2;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }
    
    .media-card-title {
        font-size: 1.125rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 0.75rem;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    .media-card-description {
        font-size: 0.875rem;
        color: #64748b;
        margin-bottom: 1rem;
        flex-grow: 1;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.6;
    }
    
    .media-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: auto;
        padding-top: 1rem;
        border-top: 1px solid #e2e8f0;
    }
    
    .media-card-date {
        font-size: 0.875rem;
        color: #94a3b8;
    }
    
    .media-card-link {
        color: #0891b2;
        font-weight: 600;
        text-decoration: none;
        font-size: 0.875rem;
        display: flex;
        align-items: center;
        gap: 0.25rem;
        transition: color 0.2s ease;
    }
    
    .media-card-link:hover {
        color: #0e7490;
    }
</style>

